<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= order.orderNumber %> | MIASHKA Admin
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        :root {
            --gold: #b88a44;
            --dark: #181818;
            --cream: #f8f5f2;
            --border: #ece6de;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--cream);
            color: var(--dark);
        }

        .page-container {
            max-width: 1400px;
            margin: auto;
            padding: 35px 20px 60px;
        }

        .card-custom {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 22px;
            overflow: hidden;
        }

        .gold-line {
            height: 4px;
            background: var(--gold);
        }

        .gold-text {
            color: var(--gold);
        }

        .section-title {
            font-size: 21px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .info-box {
            background: var(--cream);
            border-radius: 16px;
            padding: 18px;
            height: 100%;
        }

        .info-label {
            color: #777;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 7px;
        }

        .info-value {
            font-weight: 600;
            word-break: break-word;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 8px 14px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
        }

        .product-image {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 15px;
            border: 1px solid var(--border);
            background: var(--cream);
        }

        .btn-dark-custom {
            background: var(--dark);
            color: #fff;
            border: 0;
            border-radius: 30px;
            padding: 12px 22px;
            font-weight: 500;
            transition: 0.25s;
        }

        .btn-dark-custom:hover {
            background: var(--gold);
            color: #fff;
        }

        .btn-dark-custom:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .btn-outline-custom {
            border: 1px solid var(--dark);
            color: var(--dark);
            background: transparent;
            border-radius: 30px;
            padding: 10px 20px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .btn-outline-custom:hover {
            background: var(--dark);
            color: #fff;
        }

        .tracking-item {
            position: relative;
            padding-left: 30px;
            padding-bottom: 25px;
        }

        .tracking-item:not(:last-child)::before {
            content: "";
            position: absolute;
            left: 7px;
            top: 18px;
            bottom: 0;
            width: 2px;
            background: var(--border);
        }

        .tracking-dot {
            position: absolute;
            left: 0;
            top: 4px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: var(--gold);
            border: 4px solid #f3e8d6;
        }

        .amount-row {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 12px;
        }

        .amount-total {
            border-top: 1px solid var(--border);
            padding-top: 15px;
            margin-top: 15px;
            font-size: 18px;
            font-weight: 700;
        }

        @media (max-width: 767px) {
            .page-container {
                padding: 20px 12px 40px;
            }

            .product-image {
                width: 80px;
                height: 80px;
            }

            .mobile-full {
                width: 100%;
            }
        }
    </style>
</head>

<body>

<div class="page-container">

    <!-- =====================================================
         BACK
    ====================================================== -->

    <div class="mb-4">

        <a
            href="/admin/orders"
            class="btn-outline-custom"
        >
            ← Back to Orders
        </a>

    </div>


    <!-- =====================================================
         ORDER HEADER
    ====================================================== -->

    <div class="card-custom mb-4">

        <div class="gold-line"></div>

        <div class="p-4 p-lg-5">

            <div
                class="d-flex flex-column flex-lg-row justify-content-between gap-4"
            >

                <div>

                    <div
                        class="gold-text text-uppercase fw-semibold mb-2"
                        style="font-size: 12px; letter-spacing: 4px;"
                    >
                        MIASHKA ORDER
                    </div>

                    <h1 class="h2 mb-3">
                        <%= order.orderNumber %>
                    </h1>

                    <div class="text-secondary">

                        Placed on

                        <%= new Date(order.createdAt).toLocaleString(
                            "en-IN",
                            {
                                day: "2-digit",
                                month: "short",
                                year: "numeric",
                                hour: "2-digit",
                                minute: "2-digit"
                            }
                        ) %>

                    </div>

                </div>


                <div
                    class="d-flex flex-wrap align-items-start gap-2"
                >

                    <% if (order.paymentStatus === "SUCCESS") { %>

                        <span
                            class="status-badge bg-success-subtle text-success"
                        >
                            PAYMENT SUCCESS
                        </span>

                    <% } else { %>

                        <span
                            class="status-badge bg-warning-subtle text-warning-emphasis"
                        >
                            <%= order.paymentStatus %>
                        </span>

                    <% } %>


                    <% if (order.orderStatus === "DELIVERED") { %>

                        <span
                            class="status-badge bg-success-subtle text-success"
                        >
                            DELIVERED
                        </span>

                    <% } else if (order.orderStatus === "CANCELLED") { %>

                        <span
                            class="status-badge bg-danger-subtle text-danger"
                        >
                            CANCELLED
                        </span>

                    <% } else if (
                        order.orderStatus === "SHIPPED" ||
                        order.orderStatus === "OUT_FOR_DELIVERY"
                    ) { %>

                        <span
                            class="status-badge bg-primary-subtle text-primary"
                        >
                            <%= order.orderStatus.replaceAll("_", " ") %>
                        </span>

                    <% } else { %>

                        <span
                            class="status-badge bg-secondary-subtle text-secondary"
                        >
                            <%= order.orderStatus.replaceAll("_", " ") %>
                        </span>

                    <% } %>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         CUSTOMER + SHIPPING
    ====================================================== -->

    <div class="row g-4 mb-4">

        <!-- CUSTOMER -->

        <div class="col-12 col-lg-6">

            <div class="card-custom p-4 h-100">

                <h2 class="section-title">
                    Customer
                </h2>

                <div class="row g-3">

                    <div class="col-12 col-sm-6">
                        <div class="info-box">

                            <div class="info-label">
                                Name
                            </div>

                            <div class="info-value">
                                <%= order.user?.firstName || "" %>
                                <%= order.user?.lastName || "" %>

                                <% if (
                                    !order.user?.firstName &&
                                    !order.user?.lastName
                                ) { %>
                                    <%= order.user?.userName || "Customer" %>
                                <% } %>
                            </div>

                        </div>
                    </div>


                    <div class="col-12 col-sm-6">
                        <div class="info-box">

                            <div class="info-label">
                                Email
                            </div>

                            <div class="info-value">
                                <%= order.user?.email || "—" %>
                            </div>

                        </div>
                    </div>


                    <div class="col-12 col-sm-6">
                        <div class="info-box">

                            <div class="info-label">
                                Mobile
                            </div>

                            <div class="info-value">
                                <%= order.shippingAddress?.mobile || order.user?.mobile || "—" %>
                            </div>

                        </div>
                    </div>


                    <div class="col-12 col-sm-6">
                        <div class="info-box">

                            <div class="info-label">
                                User ID
                            </div>

                            <div class="info-value">
                                <%= order.user?._id || "—" %>
                            </div>

                        </div>
                    </div>

                </div>

            </div>

        </div>


        <!-- SHIPPING -->

        <div class="col-12 col-lg-6">

            <div class="card-custom p-4 h-100">

                <h2 class="section-title">
                    Shipping Address
                </h2>

                <div class="info-box">

                    <div class="fw-semibold fs-5 mb-2">

                        <%= order.shippingAddress?.firstName || "" %>
                        <%= order.shippingAddress?.lastName || "" %>

                    </div>


                    <% if (order.shippingAddress?.company) { %>

                        <div class="text-secondary mb-1">
                            <%= order.shippingAddress.company %>
                        </div>

                    <% } %>


                    <div>
                        <%= order.shippingAddress?.address || "—" %>
                    </div>


                    <div>

                        <%= order.shippingAddress?.city || "" %>

                        <% if (order.shippingAddress?.state) { %>
                            ,
                            <%= order.shippingAddress.state %>
                        <% } %>

                    </div>


                    <div>

                        <%= order.shippingAddress?.country || "" %>

                        <% if (order.shippingAddress?.pinCode) { %>
                            -
                            <%= order.shippingAddress.pinCode %>
                        <% } %>

                    </div>


                    <div class="mt-3 fw-semibold">
                        <%= order.shippingAddress?.mobile || "" %>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PRODUCTS
    ====================================================== -->

    <div class="card-custom p-4 mb-4">

        <h2 class="section-title">
            Jewellery Purchased
        </h2>


        <% if (!order.items || order.items.length === 0) { %>

            <div class="text-secondary">
                No products found.
            </div>

        <% } else { %>

            <div class="d-flex flex-column gap-3">

                <% order.items.forEach(item => { %>

                    <div
                        class="border rounded-4 p-3"
                        style="border-color: #ece6de !important;"
                    >

                        <div
                            class="d-flex flex-column flex-md-row gap-3 align-items-md-center"
                        >

                            <!-- IMAGE -->

                            <div>

                                <% if (item.image) { %>

                                    <img
                                        src="<%= item.image %>"
                                        alt="<%= item.title %>"
                                        class="product-image"
                                    >

                                <% } else if (
                                    item.product?.images?.length
                                ) { %>

                                    <img
                                        src="<%= item.product.images[0] %>"
                                        alt="<%= item.title %>"
                                        class="product-image"
                                    >

                                <% } else { %>

                                    <div
                                        class="product-image d-flex align-items-center justify-content-center text-secondary"
                                    >
                                        No Image
                                    </div>

                                <% } %>

                            </div>


                            <!-- PRODUCT -->

                            <div class="flex-grow-1">

                                <h3 class="h5 mb-2">
                                    <%= item.title %>
                                </h3>


                                <% if (item.product?.sku) { %>

                                    <div class="small text-secondary mb-2">
                                        SKU:
                                        <%= item.product.sku %>
                                    </div>

                                <% } %>


                                <div class="row g-3 mt-1">

                                    <div class="col-6 col-md-3">

                                        <div class="info-label">
                                            Quantity
                                        </div>

                                        <strong>
                                            <%= item.quantity %>
                                        </strong>

                                    </div>


                                    <div class="col-6 col-md-3">

                                        <div class="info-label">
                                            Price
                                        </div>

                                        <strong>
                                            ₹<%= Number(item.price || 0).toLocaleString("en-IN") %>
                                        </strong>

                                    </div>


                                    <div class="col-6 col-md-3">

                                        <div class="info-label">
                                            GST
                                        </div>

                                        <strong>
                                            ₹<%= Number(item.gst || 0).toLocaleString("en-IN") %>
                                        </strong>

                                    </div>


                                    <div class="col-6 col-md-3">

                                        <div class="info-label">
                                            Total
                                        </div>

                                        <strong>
                                            ₹<%= Number(item.total || 0).toLocaleString("en-IN") %>
                                        </strong>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>


    <!-- =====================================================
         PAYMENT + SHIPROCKET
    ====================================================== -->

    <div class="row g-4 mb-4">

        <!-- PAYMENT -->

        <div class="col-12 col-lg-6">

            <div class="card-custom p-4 h-100">

                <h2 class="section-title">
                    Payment Summary
                </h2>


                <div class="amount-row">

                    <span class="text-secondary">
                        Subtotal
                    </span>

                    <strong>
                        ₹<%= Number(order.subtotal || 0).toLocaleString("en-IN") %>
                    </strong>

                </div>


                <div class="amount-row">

                    <span class="text-secondary">
                        GST
                    </span>

                    <strong>
                        ₹<%= Number(order.gstTotal || 0).toLocaleString("en-IN") %>
                    </strong>

                </div>


                <div class="amount-row">

                    <span class="text-secondary">
                        Shipping
                    </span>

                    <strong>
                        ₹<%= Number(order.shippingCharge || 0).toLocaleString("en-IN") %>
                    </strong>

                </div>


                <div class="amount-row">

                    <span class="text-secondary">
                        Discount
                    </span>

                    <strong>
                        - ₹<%= Number(order.discount || 0).toLocaleString("en-IN") %>
                    </strong>

                </div>


                <div class="amount-row amount-total">

                    <span>
                        Total
                    </span>

                    <span class="gold-text">
                        ₹<%= Number(order.amount || 0).toLocaleString("en-IN") %>
                    </span>

                </div>


                <hr>


                <div class="row g-3">

                    <div class="col-6">

                        <div class="info-label">
                            Payment Method
                        </div>

                        <strong>
                            <%= order.paymentMethod || "—" %>
                        </strong>

                    </div>


                    <div class="col-6">

                        <div class="info-label">
                            Payment Status
                        </div>

                        <strong>
                            <%= order.paymentStatus %>
                        </strong>

                    </div>


                    <% if (order.razorpayPaymentId) { %>

                        <div class="col-12">

                            <div class="info-label">
                                Razorpay Payment ID
                            </div>

                            <div class="info-value">
                                <%= order.razorpayPaymentId %>
                            </div>

                        </div>

                    <% } %>

                </div>

            </div>

        </div>


        <!-- SHIPROCKET -->

        <div class="col-12 col-lg-6">

            <div class="card-custom p-4 h-100">

                <h2 class="section-title">
                    Shiprocket
                </h2>


                <% if (!order.shiprocket?.orderId) { %>

                    <div class="info-box">

                        <strong>
                            Shipment not created
                        </strong>

                        <p class="text-secondary mb-0 mt-2">
                            No Shiprocket order is currently associated
                            with this order.
                        </p>

                    </div>

                <% } else { %>

                    <div class="row g-3">

                        <div class="col-12 col-sm-6">

                            <div class="info-box">

                                <div class="info-label">
                                    Shiprocket Order ID
                                </div>

                                <div class="info-value">
                                    <%= order.shiprocket.orderId %>
                                </div>

                            </div>

                        </div>


                        <div class="col-12 col-sm-6">

                            <div class="info-box">

                                <div class="info-label">
                                    Shipment ID
                                </div>

                                <div class="info-value">
                                    <%= order.shiprocket.shipmentId || "—" %>
                                </div>

                            </div>

                        </div>


                        <div class="col-12 col-sm-6">

                            <div class="info-box">

                                <div class="info-label">
                                    AWB
                                </div>

                                <div class="info-value">
                                    <%= order.shiprocket.awbCode || "Not Assigned" %>
                                </div>

                            </div>

                        </div>


                        <div class="col-12 col-sm-6">

                            <div class="info-box">

                                <div class="info-label">
                                    Courier
                                </div>

                                <div class="info-value">
                                    <%= order.shiprocket.courierName || "Not Assigned" %>
                                </div>

                            </div>

                        </div>


                        <div class="col-12">

                            <div class="info-box">

                                <div class="info-label">
                                    Shiprocket Status
                                </div>

                                <div class="info-value">
                                    <%= order.shiprocket.currentStatus || "—" %>
                                </div>

                            </div>

                        </div>

                    </div>

                <% } %>


                <!-- ==========================================
                     READY TO SHIP
                =========================================== -->

                <% if (
                    order.paymentStatus === "SUCCESS" &&
                    order.shiprocket?.shipmentId &&
                    !order.shiprocket?.awbCode &&
                    order.orderStatus !== "CANCELLED" &&
                    order.orderStatus !== "DELIVERED" &&
                    order.orderStatus !== "RETURNED"
                ) { %>

                    <div class="mt-4">

                        <button
                            type="button"
                            id="readyToShipButton"
                            class="btn-dark-custom mobile-full"
                            onclick="readyToShip('<%= order._id %>')"
                        >
                            Ready to Ship
                        </button>


                        <p class="small text-secondary mt-3 mb-0">

                            Click only after the jewellery has been
                            packed and is ready for courier pickup.

                        </p>

                    </div>

                <% } %>

                <!-- ==========================================
                    REASSIGN CANCELLED SHIPMENT
                =========================================== -->

                <%
                    const shiprocketStatus =
                        String(
                            order.shiprocket?.currentStatus || ""
                        ).toUpperCase();

                    const shipmentCancelled =
                        shiprocketStatus.includes("CANCEL");
                %>

                <% if (
                    shipmentCancelled &&
                    order.paymentStatus === "SUCCESS" &&
                    order.orderStatus !== "CANCELLED" &&
                    order.orderStatus !== "DELIVERED" &&
                    order.orderStatus !== "RETURNED"
                ) { %>

                    <div class="mt-4">

                        <div class="alert alert-danger">

                            <strong>
                                Courier Shipment Cancelled
                            </strong>

                            <div class="small mt-1">
                                This Shiprocket shipment was cancelled,
                                but the MIASHKA customer order is still active.
                            </div>

                   <% if (order.shiprocket?.awbCode) { %>

                        <div class="small mt-2">
                            Previous AWB:
                            <strong>
                                <%= order.shiprocket.awbCode %>
                            </strong>
                        </div>

                    <% } %>

                        </div>


                        <button
                            type="button"
                            id="reassignShipmentButton"
                            class="btn-dark-custom mobile-full"
                            onclick="reassignShipment('<%= order._id %>')"
                        >
                            Reassign Shipment
                        </button>


                        <p class="small text-secondary mt-3 mb-0">
                            This will archive the cancelled shipment
                            and create a new Shiprocket shipment.
                        </p>

                    </div>

                <% } %>


                <% if (order.orderStatus === "CANCELLED") { %>

                    <div class="alert alert-danger mt-4 mb-0">

                        <strong>
                            Order Cancelled
                        </strong>

                        <div class="small mt-1">
                            This MIASHKA order has been cancelled.
                        </div>

                        <% if (order.cancelledAt) { %>
                            <div class="small mt-2">
                                Cancelled on:
                                <%= new Date(order.cancelledAt).toLocaleString("en-IN") %>
                            </div>
                        <% } %>

                    </div>

                <% } else if (
                    order.shiprocket?.awbCode &&
                    !shipmentCancelled
                ) { %>

                    <div class="alert alert-success mt-4 mb-0">

                        <strong>
                            Shipment Ready
                        </strong>

                        <div class="small mt-1">

                            AWB:
                            <%= order.shiprocket.awbCode %>

                            <% if (order.shiprocket.courierName) { %>
                                <br>
                                Courier:
                                <%= order.shiprocket.courierName %>
                            <% } %>

                        </div>

                    </div>

                <% } %>

            </div>

        </div>

    </div>


    <!-- =====================================================
         TRACKING
    ====================================================== -->

    <div class="card-custom p-4">

        <h2 class="section-title">
            Order Timeline
        </h2>


        <% if (!order.tracking || order.tracking.length === 0) { %>

            <div class="text-secondary">
                No tracking updates.
            </div>

        <% } else { %>

            <div>

                <%
                    const trackingEvents =
                        [...order.tracking].reverse();
                %>


                <% trackingEvents.forEach(event => { %>

                    <div class="tracking-item">

                        <div class="tracking-dot"></div>


                        <div class="fw-semibold">
                            <%= event.status %>
                        </div>


                        <% if (event.message) { %>

                            <div class="text-secondary mt-1">
                                <%= event.message %>
                            </div>

                        <% } %>


                        <div class="small text-secondary mt-2">

                            <% if (event.location) { %>

                                <%= event.location %>

                                &nbsp;•&nbsp;

                            <% } %>


                            <% if (event.date) { %>

                                <%= new Date(
                                    event.date
                                ).toLocaleString(
                                    "en-IN"
                                ) %>

                            <% } %>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

</div>


<!-- =========================================================
     READY TO SHIP SCRIPT
========================================================== -->

<script>
    async function reassignShipment(orderId) {

        const button =
            document.getElementById(
                "reassignShipmentButton"
            );


        const confirmed = confirm(
            "The current courier shipment is cancelled. Create a new Shiprocket shipment for this order?"
        );


        if (!confirmed) {
            return;
        }


        const originalText =
            button.innerText;


        try {

            button.disabled = true;

            button.innerText =
                "Creating New Shipment...";


            const response = await fetch(
                `/admin/shipping/orders/${orderId}/reassign`,
                {
                    method: "POST",

                    credentials: "include",

                    headers: {
                        "Content-Type":
                            "application/json"
                    }
                }
            );


            const contentType =
                response.headers.get(
                    "content-type"
                );


            if (
                !contentType ||
                !contentType.includes(
                    "application/json"
                )
            ) {
                throw new Error(
                    "Server returned an invalid response."
                );
            }


            const data =
                await response.json();


            if (!response.ok) {
                throw new Error(
                    data.message ||
                    "Unable to reassign shipment."
                );
            }


            alert(
                data.message ||
                "New shipment created successfully."
            );


            window.location.reload();

        }

        catch (error) {

            console.error(
                "Reassign Shipment Error:",
                error
            );


            alert(
                error.message ||
                "Something went wrong."
            );


            button.disabled = false;

            button.innerText =
                originalText;
        }
    }

async function readyToShip(orderId) {

    const button =
        document.getElementById(
            "readyToShipButton"
        );


    const confirmed = confirm(
        "Is this jewellery packed and ready for courier pickup?"
    );


    if (!confirmed) {
        return;
    }


    const originalText =
        button.innerText;


    try {

        button.disabled = true;

        button.innerText =
            "Preparing Shipment...";


        const response = await fetch(
            `/admin/shipping/orders/${orderId}/ready-to-ship`,
            {
                method: "POST",

                credentials: "include",

                headers: {
                    "Content-Type":
                        "application/json"
                }
            }
        );


        /*
         * Protect against an HTML response
         * accidentally being returned.
         */

        const contentType =
            response.headers.get(
                "content-type"
            );


        if (
            !contentType ||
            !contentType.includes(
                "application/json"
            )
        ) {

            throw new Error(
                "Server returned an invalid response."
            );

        }


        const data =
            await response.json();


        if (!response.ok) {

            throw new Error(
                data.message ||
                "Unable to prepare shipment."
            );

        }


        alert(
            data.message ||
            "Shipment prepared successfully."
        );


        window.location.reload();

    }

    catch (error) {

        console.error(
            "Ready To Ship Error:",
            error
        );


        alert(
            error.message ||
            "Something went wrong."
        );


        button.disabled = false;

        button.innerText =
            originalText;

    }

}

</script>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>

</body>

