<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Orders | MIASHKA Admin</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: #f8f5f2;
            color: #181818;
        }

        .page-container {
            max-width: 1400px;
            margin: auto;
            padding: 40px 20px;
        }

        .gold {
            color: #b88a44;
        }

        .order-card {
            background: white;
            border: 1px solid #ece6de;
            border-radius: 20px;
            transition: 0.25s ease;
        }

        .order-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
        }

        .badge-custom {
            padding: 8px 12px;
            border-radius: 30px;
            font-size: 12px;
        }

        .order-table th {
            color: #777;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            white-space: nowrap;
        }

        .order-table td {
            vertical-align: middle;
        }

        .view-btn {
            background: #181818;
            color: white;
            border-radius: 30px;
            padding: 9px 18px;
            text-decoration: none;
            display: inline-block;
            white-space: nowrap;
        }

        .view-btn:hover {
            background: #b88a44;
            color: white;
        }

        @media (max-width: 767px) {
            .page-container {
                padding: 25px 15px;
            }
        }
    </style>

</head>

<body>

<div class="page-container">

    <!-- =========================================
         HEADER
    ========================================== -->

    <div class="mb-5">

        <p
            class="gold fw-semibold text-uppercase mb-2"
            style="letter-spacing: 4px; font-size: 12px;"
        >
            MIASHKA ADMIN
        </p>

        <h1 class="display-6 fw-semibold">
            Orders
        </h1>

        <p class="text-secondary mb-0">
            Manage customer orders, payments and shipments.
        </p>

    </div>


    <!-- =========================================
         STATS
    ========================================== -->

    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">
            <div class="order-card p-4 h-100">

                <p class="text-secondary small mb-2">
                    Total Orders
                </p>

                <h3 class="mb-0">
                    <%= orders.length %>
                </h3>

            </div>
        </div>


        <div class="col-6 col-lg-3">
            <div class="order-card p-4 h-100">

                <p class="text-secondary small mb-2">
                    Paid
                </p>

                <h3 class="mb-0">

                    <%= orders.filter(
                        order =>
                            order.paymentStatus === "SUCCESS"
                    ).length %>

                </h3>

            </div>
        </div>


        <div class="col-6 col-lg-3">
            <div class="order-card p-4 h-100">

                <p class="text-secondary small mb-2">
                    Ready / Packed
                </p>

                <h3 class="mb-0">

                    <%= orders.filter(
                        order =>
                            order.orderStatus === "PACKED"
                    ).length %>

                </h3>

            </div>
        </div>


        <div class="col-6 col-lg-3">
            <div class="order-card p-4 h-100">

                <p class="text-secondary small mb-2">
                    Delivered
                </p>

                <h3 class="mb-0">

                    <%= orders.filter(
                        order =>
                            order.orderStatus === "DELIVERED"
                    ).length %>

                </h3>

            </div>
        </div>

    </div>


    <!-- =========================================
         ORDERS
    ========================================== -->

    <div class="order-card overflow-hidden">

        <% if (!orders || orders.length === 0) { %>

            <div class="text-center p-5">

                <h4>No Orders Yet</h4>

                <p class="text-secondary mb-0">
                    Customer orders will appear here.
                </p>

            </div>

        <% } else { %>

            <div class="table-responsive">

                <table
                    class="table order-table align-middle mb-0"
                >

                    <thead class="table-light">

                        <tr>

                            <th class="px-4 py-3">
                                Order
                            </th>

                            <th>
                                Customer
                            </th>

                            <th>
                                Amount
                            </th>

                            <th>
                                Payment
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Date
                            </th>

                            <th class="text-end px-4">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                    <% orders.forEach(order => { %>

                        <tr>

                            <!-- ORDER NUMBER -->

                            <td class="px-4 py-4">

                                <strong>
                                    <%= order.orderNumber %>
                                </strong>

                                <div class="small text-secondary mt-1">

                                    <%= order.items?.length || 0 %>
                                    item<%= order.items?.length === 1 ? "" : "s" %>

                                </div>

                            </td>


                            <!-- CUSTOMER -->

                            <td>

                                <div class="fw-semibold">

                                    <%= 
                                        order.user?.firstName ||
                                        order.user?.userName ||
                                        "Customer"
                                    %>

                                    <%= order.user?.lastName || "" %>

                                </div>

                                <div class="small text-secondary">

                                    <%= order.user?.email || "—" %>

                                </div>

                            </td>


                            <!-- AMOUNT -->

                            <td>

                                <strong>
                                    ₹<%= Number(order.amount || 0).toLocaleString("en-IN") %>
                                </strong>

                            </td>


                            <!-- PAYMENT -->

                            <td>

                                <% if (order.paymentStatus === "SUCCESS") { %>

                                    <span
                                        class="badge-custom bg-success-subtle text-success"
                                    >
                                        PAID
                                    </span>

                                <% } else if (order.paymentStatus === "FAILED") { %>

                                    <span
                                        class="badge-custom bg-danger-subtle text-danger"
                                    >
                                        FAILED
                                    </span>

                                <% } else if (order.paymentStatus === "REFUNDED") { %>

                                    <span
                                        class="badge-custom bg-info-subtle text-info"
                                    >
                                        REFUNDED
                                    </span>

                                <% } else { %>

                                    <span
                                        class="badge-custom bg-warning-subtle text-warning-emphasis"
                                    >
                                        <%= order.paymentStatus %>
                                    </span>

                                <% } %>

                            </td>


                            <!-- ORDER STATUS -->

                            <td>

                                <% if (order.orderStatus === "DELIVERED") { %>

                                    <span
                                        class="badge-custom bg-success-subtle text-success"
                                    >
                                        DELIVERED
                                    </span>

                                <% } else if (
                                    order.orderStatus === "SHIPPED" ||
                                    order.orderStatus === "OUT_FOR_DELIVERY"
                                ) { %>

                                    <span
                                        class="badge-custom bg-primary-subtle text-primary"
                                    >
                                        <%= order.orderStatus.replaceAll("_", " ") %>
                                    </span>

                                <% } else if (order.orderStatus === "CANCELLED") { %>

                                    <span
                                        class="badge-custom bg-danger-subtle text-danger"
                                    >
                                        CANCELLED
                                    </span>

                                <% } else { %>

                                    <span
                                        class="badge-custom bg-secondary-subtle text-secondary"
                                    >
                                        <%= order.orderStatus.replaceAll("_", " ") %>
                                    </span>

                                <% } %>

                            </td>


                            <!-- DATE -->

                            <td class="text-secondary">

                                <%= new Date(
                                    order.createdAt
                                ).toLocaleDateString(
                                    "en-IN",
                                    {
                                        day: "2-digit",
                                        month: "short",
                                        year: "numeric"
                                    }
                                ) %>

                            </td>


                            <!-- ACTION -->

                            <td class="text-end px-4">

                                <a
                                    href="/admin/orders/<%= order._id %>"
                                    class="view-btn"
                                >
                                    View Details
                                </a>

                            </td>

                        </tr>

                    <% }) %>

                    </tbody>

                </table>

            </div>

        <% } %>

    </div>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>

</body>

</html>