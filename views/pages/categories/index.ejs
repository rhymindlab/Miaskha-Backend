<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Categories | Admin Panel
    </title>

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/admin.css"
    >

</head>

<body>

<div class="admin-wrapper">

    <!-- Sidebar -->
    <%- include("../../partials/sidebar") %>

    <main class="admin-main">

        <!-- Header -->
        <%- include("../../partials/header") %>

        <section class="admin-content">

            <div class="container-fluid">

                <!-- Page Header -->

                <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">

                    <div>

                        <h2 class="fw-bold mb-1">

                            Categories

                        </h2>

                        <p class="text-muted mb-0">

                            Manage all product categories from one place.

                        </p>

                    </div>

                    <div class="d-flex gap-2">

                        <a
                            href="/admin/category/add"
                            class="btn btn-success rounded-3 px-4"
                        >

                            <i class="bi bi-plus-lg me-2"></i>

                            Add Category

                        </a>

                    </div>

                </div>

                <!-- Statistics -->

                <div class="row g-4 mb-4">

                    <div class="col-xl-3 col-md-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <small class="text-muted">

                                            Total Categories

                                        </small>

                                        <h2 class="fw-bold mt-2 mb-0">

                                            <%= categories.length %>

                                        </h2>

                                    </div>

                                    <div
                                        class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center"
                                        style="width:65px;height:65px;"
                                    >

                                        <i class="bi bi-grid fs-2 text-success"></i>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-xl-3 col-md-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <small class="text-muted">

                                            Parent Categories

                                        </small>

                                        <h2 class="fw-bold mt-2 mb-0">

                                            <%= categories.filter(c => !c.parentCategory).length %>

                                        </h2>

                                    </div>

                                    <div
                                        class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center"
                                        style="width:65px;height:65px;"
                                    >

                                        <i class="bi bi-diagram-3 fs-2 text-primary"></i>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-xl-3 col-md-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <small class="text-muted">

                                            Child Categories

                                        </small>

                                        <h2 class="fw-bold mt-2 mb-0">

                                            <%= categories.filter(c => c.parentCategory).length %>

                                        </h2>

                                    </div>

                                    <div
                                        class="rounded-circle bg-warning bg-opacity-10 d-flex align-items-center justify-content-center"
                                        style="width:65px;height:65px;"
                                    >

                                        <i class="bi bi-diagram-2 fs-2 text-warning"></i>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-xl-3 col-md-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <small class="text-muted">

                                            Collections

                                        </small>

                                        <h2 class="fw-bold mt-2 mb-0">

                                            <%= collections.length %>

                                        </h2>

                                    </div>

                                    <div
                                        class="rounded-circle bg-danger bg-opacity-10 d-flex align-items-center justify-content-center"
                                        style="width:65px;height:65px;"
                                    >

                                        <i class="bi bi-collection fs-2 text-danger"></i>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Search & Table Card -->

                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-header bg-white border-0 p-4">

                        <div class="row align-items-center">

                            <div class="col-lg-6">

                                <h5 class="fw-bold mb-0">

                                    Category List

                                </h5>

                            </div>

                            <div class="col-lg-6">

                                <input
                                    id="categorySearch"
                                    type="text"
                                    class="form-control"
                                    placeholder="Search category..."
                                >

                            </div>

                        </div>

                    </div>

                    <div class="table-responsive">
                                              <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th width="60">
                                        #
                                    </th>

                                    <th width="90">
                                        Image
                                    </th>

                                    <th>
                                        Name
                                    </th>

                                    <th>
                                        Slug
                                    </th>

                                    <th>
                                        Parent
                                    </th>

                                    <th>
                                        Collections
                                    </th>

                                    <th class="text-center" width="180">
                                        Actions
                                    </th>

                                </tr>

                            </thead>

                            <tbody id="categoryTable">

                                <% if(categories.length === 0){ %>

                                    <tr>

                                        <td colspan="7" class="text-center py-5">

                                            <i class="bi bi-folder2-open display-4 text-secondary"></i>

                                            <h5 class="mt-3">

                                                No Categories Found

                                            </h5>

                                            <p class="text-muted mb-4">

                                                Start by creating your first category.

                                            </p>

                                            <a
                                                href="admin/category/add"
                                                class="btn btn-success"
                                            >

                                                <i class="bi bi-plus-lg me-2"></i>

                                                Add Category

                                            </a>

                                        </td>

                                    </tr>

                                <% } %>

                                <% categories.forEach((category,index)=>{ %>

                                <tr>

                                    <td>

                                        <%= index + 1 %>

                                    </td>

                                    <td>

                                        <% if(category.image){ %>

                                            <img
                                                src="<%= category.image %>"
                                                class="rounded-3 border"
                                                width="60"
                                                height="60"
                                                style="object-fit:cover;"
                                            >

                                        <% } else { %>

                                            <div
                                                class="rounded-3 border bg-light d-flex align-items-center justify-content-center"
                                                style="width:60px;height:60px;"
                                            >

                                                <i class="bi bi-image text-secondary fs-4"></i>

                                            </div>

                                        <% } %>

                                    </td>

                                    <td>

                                        <div class="fw-semibold">

                                            <%= category.name %>

                                        </div>

                                    </td>

                                    <td>

                                        <span class="text-muted">

                                            <%= category.slug %>

                                        </span>

                                    </td>

                                    <td>

                                        <% if(category.parentCategory){ %>

                                            <span class="badge bg-warning text-dark">

                                                Child Category

                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-success">

                                                Parent Category

                                            </span>

                                        <% } %>

                                    </td>

                                    <td>

                                        <% if(category.collections && category.collections.length){ %>

                                            <% category.collections.forEach(collection=>{ %>

                                                <span class="badge bg-primary me-1">

                                                    <%= collection.name || collection %>

                                                </span>

                                            <% }) %>

                                        <% } else { %>

                                            <span class="text-muted">

                                                --

                                            </span>

                                        <% } %>

                                    </td>

                                    <td>

    <div class="d-flex justify-content-center gap-2">

        <a
            href="/admin/category/edit/<%= category._id %>"
            class="btn btn-warning btn-sm text-white"
            title="Edit Category"
        >

            <i class="bi bi-pencil-square"></i>

        </a>

        <form
            action="/category/<%= category._id %>?_method=DELETE"
            method="POST"
            onsubmit="return confirm('Are you sure you want to delete this category?')"
        >

            <button
                type="submit"
                class="btn btn-danger btn-sm"
                title="Delete Category"
            >

                <i class="bi bi-trash"></i>

            </button>

        </form>

    </div>

</td>

                                </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </section>

        <%- include("../../partials/footer") %>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<script>

const searchInput = document.getElementById("categorySearch");

searchInput.addEventListener("keyup", function(){

    const value = this.value.toLowerCase();

    document.querySelectorAll("#categoryTable tr").forEach((row)=>{

        row.style.display = row.innerText.toLowerCase().includes(value)
            ? ""
            : "none";

    });

});

</script>

</body>

</html>