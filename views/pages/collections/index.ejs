<!DOCTYPE html>
<html lang="en">

<%- include("../../partials/head") %>

<body>

<div class="admin-wrapper">

    <!-- Sidebar -->
    <%- include("../../partials/sidebar") %>

    <!-- Main -->
    <main class="admin-main">

        <!-- Header -->
        <%- include("../../partials/header") %>

        <!-- Page Content -->
        <section class="admin-content">

            <div class="container-fluid">

                <!-- Page Header -->

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>

                        <h2 class="fw-bold mb-1">

                            Collections

                        </h2>

                        <p class="text-muted mb-0">

                            Manage all product collections.

                        </p>

                    </div>

                    <a
                        href="/admin/collection/add"
                        class="btn btn-success rounded-3 px-4">

                        <i class="bi bi-plus-lg me-2"></i>

                        Add Collection

                    </a>

                </div>

                <!-- Statistics -->

                <div class="row g-4 mb-4">

                    <div class="col-lg-4">

                        <div class="card border-0 shadow-sm rounded-4">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <small class="text-muted">

                                            Total Collections

                                        </small>

                                        <h2 class="fw-bold mt-2 mb-0">

                                            <%= collections.length %>

                                        </h2>

                                    </div>

                                    <div
                                        class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center"
                                        style="width:65px;height:65px;">

                                        <i class="bi bi-collection text-success fs-2"></i>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Table -->

                <div class="card shadow-sm border-0 rounded-4">

                    <div class="card-header bg-white border-0 p-4">

                        <div class="row">

                            <div class="col-lg-6">

                                <h5 class="fw-bold mb-0">

                                    Collection List

                                </h5>

                            </div>

                            <div class="col-lg-6">

                                <input
                                    id="collectionSearch"
                                    type="text"
                                    class="form-control"
                                    placeholder="Search collections..."
                                >

                            </div>

                        </div>

                    </div>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th width="70">

                                        #

                                    </th>

                                    <th width="90">

                                        Image

                                    </th>

                                    <th>

                                        Name

                                    </th>

                                    <th>

                                        Slug

                                    </th>

                                    <th>

                                        Created

                                    </th>

                                    <th class="text-center" width="170">

                                        Actions

                                    </th>

                                </tr>

                            </thead>

                            <tbody id="collectionTable">

                                <% if(collections.length === 0){ %>

                                <tr>

                                    <td colspan="6" class="text-center py-5">

                                        <i class="bi bi-collection display-3 text-secondary"></i>

                                        <h5 class="mt-3">

                                            No Collections Found

                                        </h5>

                                        <p class="text-muted">

                                            Create your first collection.

                                        </p>

                                        <a
                                            href="/admin/collection/add"
                                            class="btn btn-success">

                                            Add Collection

                                        </a>

                                    </td>

                                </tr>

                                <% } %>

                                <% collections.forEach((collection,index)=>{ %>

                                <tr>

                                    <td>

                                        <%= index+1 %>

                                    </td>

                                    <td>

                                        <% if(collection.image){ %>

                                            <img
                                                src="<%= collection.image %>"
                                                width="60"
                                                height="60"
                                                class="rounded-3 border"
                                                style="object-fit:cover;"
                                            >

                                        <% }else{ %>

                                            <div
                                                class="bg-light rounded-3 border d-flex align-items-center justify-content-center"
                                                style="width:60px;height:60px;">

                                                <i class="bi bi-image"></i>

                                            </div>

                                        <% } %>

                                    </td>

                                    <td>

                                        <strong>

                                            <%= collection.name %>

                                        </strong>

                                    </td>

                                    <td>

                                        <span class="text-muted">

                                            <%= collection.slug %>

                                        </span>

                                    </td>

                                    <td>

                                        <%= new Date(collection.createdAt).toLocaleDateString() %>

                                    </td>

                                    <td>
                                                                                <div class="d-flex justify-content-center gap-2">

                                            <a
                                                href="/admin/collection/edit/<%= collection._id %>"
                                                class="btn btn-warning text-white btn-sm"
                                            >

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <form
                                                action="/collection/<%= collection._id %>?_method=DELETE"
                                                method="POST"
                                                onsubmit="return confirm('Delete this collection?')"
                                            >

                                                <button
                                                    type="submit"
                                                    class="btn btn-danger btn-sm"
                                                >

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </section>

        <!-- Footer -->

        <%- include("../../partials/footer") %>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<script>

const searchInput = document.getElementById("collectionSearch");

searchInput.addEventListener("keyup", function(){

    const value = this.value.toLowerCase();

    document.querySelectorAll("#collectionTable tr").forEach((row)=>{

        row.style.display = row.innerText
            .toLowerCase()
            .includes(value)
            ? ""
            : "none";

    });

});

</script>

</body>

</html>