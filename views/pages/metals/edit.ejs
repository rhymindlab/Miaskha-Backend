<!DOCTYPE html>
<html lang="en">

<%- include("../../partials/head") %>

<body>

<div class="admin-wrapper">

    <!-- Sidebar -->
    <%- include("../../partials/sidebar") %>

    <main class="admin-main">

        <!-- Header -->
        <%- include("../../partials/header") %>

        <section class="admin-content">

            <div class="container-fluid">

                <!-- Page Header -->

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>

                        <h2 class="fw-bold mb-1">

                            Edit Metal Rate

                        </h2>

                        <p class="text-muted mb-0">

                            Update the selected metal rate.

                        </p>

                    </div>

                    <a
                        href="/admin/metals"
                        class="btn btn-light border rounded-3 px-4"
                    >

                        <i class="bi bi-arrow-left me-2"></i>

                        Back

                    </a>

                </div>

                <form
                    action="/metal/<%= metal._id %>?_method=PUT"
                    method="POST"
                >

                    <div class="row g-4">

                        <!-- Left -->

                        <div class="col-lg-8">

                            <div class="card shadow-sm border-0 rounded-4">

                                <div class="card-body p-4">

                                    <h5 class="fw-bold mb-4">

                                        Metal Information

                                    </h5>

                                    <!-- Metal Type -->

                                    <div class="mb-4">

                                        <label class="form-label fw-semibold">

                                            Metal Type

                                        </label>

                                        <select
                                            class="form-select"
                                            id="metalType"
                                            name="metalType"
                                            required
                                        >

                                            <option value="Gold"
                                                <%= metal.metalType==="Gold" ? "selected" : "" %>>
                                                Gold
                                            </option>

                                            <option value="Silver"
                                                <%= metal.metalType==="Silver" ? "selected" : "" %>>
                                                Silver
                                            </option>

                                            <option value="Platinum"
                                                <%= metal.metalType==="Platinum" ? "selected" : "" %>>
                                                Platinum
                                            </option>

                                        </select>

                                    </div>

                                    <!-- Purity -->

                                    <div class="mb-4">

                                        <label class="form-label fw-semibold">

                                            Purity

                                        </label>

                                        <select
                                            class="form-select"
                                            id="purity"
                                            name="purity"
                                            required
                                        >

                                        </select>

                                    </div>

                                    <!-- Amount -->

                                    <div class="mb-4">

                                        <label class="form-label fw-semibold">

                                            Rate

                                        </label>

                                        <input
                                            type="number"
                                            class="form-control"
                                            name="amount"
                                            value="<%= metal.amount %>"
                                            required
                                        >

                                    </div>

                                    <!-- Currency -->

                                    <div>

                                        <label class="form-label fw-semibold">

                                            Currency

                                        </label>

                                        <select
                                            class="form-select"
                                            name="currency"
                                        >

                                            <option value="INR"
                                                <%= metal.currency==="INR" ? "selected" : "" %>>
                                                INR
                                            </option>

                                            <option value="USD"
                                                <%= metal.currency==="USD" ? "selected" : "" %>>
                                                USD
                                            </option>

                                            <option value="AED"
                                                <%= metal.currency==="AED" ? "selected" : "" %>>
                                                AED
                                            </option>

                                        </select>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Right -->

                        <div class="col-lg-4">

                            <div class="card shadow-sm border-0 rounded-4">

                                <div class="card-body p-4">

                                    <h5 class="fw-bold mb-3">

                                        Publish

                                    </h5>

                                    <p class="text-muted small">

                                        Save your changes.

                                    </p>

                                    <div class="d-grid gap-2">

                                        <button
                                            type="submit"
                                            class="btn btn-warning btn-lg text-white"
                                        >

                                            <i class="bi bi-pencil-square me-2"></i>

                                            Update Metal Rate

                                        </button>

                                        <a
                                            href="/admin/metals"
                                            class="btn btn-outline-secondary"
                                        >

                                            Cancel

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </form>

            </div>

        </section>

        <%- include("../../partials/footer") %>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<script>

const metalType = document.getElementById("metalType");
const purity = document.getElementById("purity");

const purityOptions = {

    Gold: ["24K","22K","18K","14K"],

    Silver: ["999","925"],

    Platinum: ["950"]

};

const selectedPurity = "<%= metal.purity %>";

function loadPurity(){

    purity.innerHTML = "";

    purityOptions[metalType.value].forEach(value=>{

        purity.innerHTML += `
            <option value="${value}"
                ${value===selectedPurity ? "selected" : ""}
            >
                ${value}
            </option>
        `;

    });

}

loadPurity();

metalType.addEventListener("change",loadPurity);

</script>

</body>

</html>