<!DOCTYPE html>
<html lang="en">

<%- include("../../partials/head") %>

<body>

<div class="admin-wrapper">

    <!-- Sidebar -->

    <%- include("../../partials/sidebar") %>

    <!-- Main -->

    <main class="admin-main">

        <!-- Header -->

        <%- include("../../partials/header") %>

        <!-- Content -->

        <section class="admin-content">

            <div class="container-fluid">

                <!-- Page Header -->

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>

                        <a
                            href="/admin/orders"
                            class="btn btn-light border mb-3"
                        >

                            <i class="bi bi-arrow-left me-2"></i>

                            Back to Orders

                        </a>

                        <h2 class="fw-bold mb-1">

                            Order
                            <span class="text-primary">

                                #<%= order.orderNumber %>

                            </span>

                        </h2>

                        <p class="text-muted mb-0">

                            Placed on

                            <%= new Date(order.createdAt).toLocaleString("en-IN") %>

                        </p>

                    </div>

                    <div class="d-flex gap-2">

                        <% if(order.shiprocket?.trackingUrl){ %>

                            <a

                                href="<%= order.shiprocket.trackingUrl %>"

                                target="_blank"

                                class="btn btn-outline-primary"

                            >

                                <i class="bi bi-truck me-2"></i>

                                Track Shipment

                            </a>

                        <% } %>

                        <button

                            onclick="window.print()"

                            class="btn btn-outline-dark"

                        >

                            <i class="bi bi-printer me-2"></i>

                            Print

                        </button>

                    </div>

                </div>

                <!-- Summary Cards -->

                <div class="row g-4 mb-4">

                    <!-- Total -->

                    <div class="col-xl-3 col-md-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body">

                                <small class="text-muted">

                                    Total Amount

                                </small>

                                <h3 class="fw-bold mt-2">

                                    ₹<%= Number(order.amount).toLocaleString("en-IN") %>

                                </h3>

                                <i class="bi bi-currency-rupee fs-2 text-success"></i>

                            </div>

                        </div>

                    </div>

                    <!-- Payment -->

                    <div class="col-xl-3 col-md-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body">

                                <small class="text-muted">

                                    Payment Status

                                </small>

                                <div class="mt-3">

                                    <% if(order.paymentStatus==="SUCCESS"){ %>

                                        <span class="badge bg-success fs-6">

                                            Paid

                                        </span>

                                    <% } else if(order.paymentStatus==="FAILED"){ %>

                                        <span class="badge bg-danger fs-6">

                                            Failed

                                        </span>

                                    <% } else if(order.paymentStatus==="REFUNDED"){ %>

                                        <span class="badge bg-info fs-6">

                                            Refunded

                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-warning text-dark fs-6">

                                            Pending

                                        </span>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Order Status -->

                    <div class="col-xl-3 col-md-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body">

                                <small class="text-muted">

                                    Order Status

                                </small>

                                <div class="mt-3">

                                    <span class="badge bg-primary fs-6">

                                        <%= order.orderStatus.replaceAll("_"," ") %>

                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Courier -->

                    <div class="col-xl-3 col-md-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body">

                                <small class="text-muted">

                                    Courier

                                </small>

                                <h5 class="fw-bold mt-3">

                                    <%= order.shiprocket?.courierName || "Not Assigned" %>

                                </h5>

                                <small class="text-muted">

                                    AWB

                                    <%= order.shiprocket?.awbCode || "-" %>

                                </small>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Customer / Shipping / Billing -->

                <div class="row g-4">
                                      <!-- Customer -->

                    <div class="col-lg-4">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body p-4">

                                <h5 class="fw-bold mb-4">

                                    <i class="bi bi-person-circle me-2 text-primary"></i>

                                    Customer

                                </h5>

                                <div class="d-flex align-items-center mb-4">

                                    <div
                                        class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center me-3"
                                        style="width:60px;height:60px;font-size:22px;"
                                    >

                                        <%= (order.customerName || order.user?.firstName || "C").charAt(0).toUpperCase() %>

                                    </div>

                                    <div>

                                        <h6 class="mb-1">

                                            <%= order.customerName || ((order.user?.firstName || "") + " " + (order.user?.lastName || "")) %>

                                        </h6>

                                        <small class="text-muted">

                                            Customer

                                        </small>

                                    </div>

                                </div>

                                <table class="table table-borderless mb-0">

                                    <tr>

                                        <th width="90">

                                            Email

                                        </th>

                                        <td>

                                            <%= order.customerEmail || order.user?.email || "-" %>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            Phone

                                        </th>

                                        <td>

                                            <%= order.customerPhone || order.user?.mobile || "-" %>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            Payment

                                        </th>

                                        <td>

                                            <%= order.paymentMethod %>

                                        </td>

                                    </tr>

                                </table>

                            </div>

                        </div>

                    </div>

                    <!-- Shipping Address -->

                    <div class="col-lg-4">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body p-4">

                                <h5 class="fw-bold mb-4">

                                    <i class="bi bi-truck me-2 text-success"></i>

                                    Shipping Address

                                </h5>

                                <p class="fw-semibold mb-1">

                                    <%= order.shippingAddress.firstName %>

                                    <%= order.shippingAddress.lastName %>

                                </p>

                                <% if(order.shippingAddress.company){ %>

                                    <p class="mb-2 text-muted">

                                        <%= order.shippingAddress.company %>

                                    </p>

                                <% } %>

                                <p class="mb-1">

                                    <%= order.shippingAddress.address %>

                                </p>

                                <p class="mb-1">

                                    <%= order.shippingAddress.city %>,

                                    <%= order.shippingAddress.state %>

                                </p>

                                <p class="mb-1">

                                    <%= order.shippingAddress.country %>

                                    -

                                    <%= order.shippingAddress.pinCode %>

                                </p>

                                <hr>

                                <div>

                                    <i class="bi bi-telephone me-2"></i>

                                    <%= order.shippingAddress.mobile %>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Billing Address -->

                    <div class="col-lg-4">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body p-4">

                                <h5 class="fw-bold mb-4">

                                    <i class="bi bi-house me-2 text-warning"></i>

                                    Billing Address

                                </h5>

                                <% if(order.sameAsBilling){ %>

                                    <div
                                        class="alert alert-success border-0 mb-3"
                                    >

                                        Same as Shipping Address

                                    </div>

                                <% } else if(order.billingAddress){ %>

                                    <p class="fw-semibold mb-1">

                                        <%= order.billingAddress.firstName %>

                                        <%= order.billingAddress.lastName %>

                                    </p>

                                    <% if(order.billingAddress.company){ %>

                                        <p class="mb-2 text-muted">

                                            <%= order.billingAddress.company %>

                                        </p>

                                    <% } %>

                                    <p class="mb-1">

                                        <%= order.billingAddress.address %>

                                    </p>

                                    <p class="mb-1">

                                        <%= order.billingAddress.city %>,

                                        <%= order.billingAddress.state %>

                                    </p>

                                    <p class="mb-1">

                                        <%= order.billingAddress.country %>

                                        -

                                        <%= order.billingAddress.pinCode %>

                                    </p>

                                    <hr>

                                    <div>

                                        <i class="bi bi-telephone me-2"></i>

                                        <%= order.billingAddress.mobile %>

                                    </div>

                                <% } else { %>

                                    <div
                                        class="text-center text-muted py-4"
                                    >

                                        <i class="bi bi-house display-5"></i>

                                        <p class="mt-3 mb-0">

                                            Billing address not available

                                        </p>

                                    </div>

                                <% } %>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Products -->

                <div class="card border-0 shadow-sm rounded-4 mt-4">

                    <div class="card-header bg-white border-0 p-4">

                        <h5 class="fw-bold mb-0">

                            Ordered Products

                        </h5>

                    </div>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>Image</th>

                                    <th>Product</th>

                                    <th>SKU</th>

                                    <th>Qty</th>

                                    <th>Price</th>

                                    <th>GST</th>

                                    <th>Total</th>

                                </tr>

                            </thead>

                            <tbody>

                                <% order.items.forEach(item=>{ %>

                                <tr>

                                    <!-- Product Image -->

                                    <td>

                                        <img
                                            src="<%= item.image || '/images/no-image.png' %>"
                                            class="rounded border"
                                            width="70"
                                            height="70"
                                            style="object-fit:cover;"
                                        >

                                    </td>

                                    <!-- Product -->

                                    <td>

                                        <div class="fw-semibold">

                                            <%= item.title %>

                                        </div>

                                    </td>

                                    <!-- SKU -->

                                    <td>

                                        <span class="badge bg-light text-dark">

                                            <%= item.sku || "-" %>

                                        </span>

                                    </td>

                                    <!-- Quantity -->

                                    <td>

                                        <span class="badge bg-primary">

                                            x <%= item.quantity %>

                                        </span>

                                    </td>

                                    <!-- Price -->

                                    <td>

                                        ₹<%= Number(item.price).toLocaleString("en-IN") %>

                                    </td>

                                    <!-- GST -->

                                    <td>

                                        ₹<%= Number(item.gst).toLocaleString("en-IN") %>

                                    </td>

                                    <!-- Total -->

                                    <td>

                                        <strong>

                                            ₹<%= Number(item.total).toLocaleString("en-IN") %>

                                        </strong>

                                    </td>

                                </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                </div>

                <!-- Payment Summary -->

                <div class="row mt-4">

                    <!-- Summary -->

                    <div class="col-lg-7">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body p-4">

                                <h5 class="fw-bold mb-4">

                                    Payment Summary

                                </h5>

                                <table class="table table-borderless mb-0">

                                    <tr>

                                        <th>

                                            Subtotal

                                        </th>

                                        <td class="text-end">

                                            ₹<%= Number(order.subtotal).toLocaleString("en-IN") %>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            GST

                                        </th>

                                        <td class="text-end">

                                            ₹<%= Number(order.gstTotal).toLocaleString("en-IN") %>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            Shipping

                                        </th>

                                        <td class="text-end">

                                            ₹<%= Number(order.shippingCharge).toLocaleString("en-IN") %>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            Discount

                                        </th>

                                        <td class="text-end text-success">

                                            - ₹<%= Number(order.discount).toLocaleString("en-IN") %>

                                        </td>

                                    </tr>

                                    <tr class="border-top">

                                        <th class="fs-5">

                                            Grand Total

                                        </th>

                                        <th class="text-end fs-4 text-primary">

                                            ₹<%= Number(order.amount).toLocaleString("en-IN") %>

                                        </th>

                                    </tr>

                                </table>

                            </div>

                        </div>

                    </div>

                    <!-- Payment Details -->

                    <div class="col-lg-5">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body p-4">

                                <h5 class="fw-bold mb-4">

                                    Payment Information

                                </h5>

                                <table class="table table-borderless">

                                    <tr>

                                        <th width="150">

                                            Method

                                        </th>

                                        <td>

                                            <%= order.paymentMethod %>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            Status

                                        </th>

                                        <td>

                                            <% if(order.paymentStatus==="SUCCESS"){ %>

                                                <span class="badge bg-success">

                                                    Paid

                                                </span>

                                            <% } else if(order.paymentStatus==="FAILED"){ %>

                                                <span class="badge bg-danger">

                                                    Failed

                                                </span>

                                            <% } else if(order.paymentStatus==="REFUNDED"){ %>

                                                <span class="badge bg-info">

                                                    Refunded

                                                </span>

                                            <% } else { %>

                                                <span class="badge bg-warning text-dark">

                                                    Pending

                                                </span>

                                            <% } %>

                                        </td>

                                    </tr>

                                    <% if(order.razorpayOrderId){ %>

                                    <tr>

                                        <th>

                                            Razorpay Order

                                        </th>

                                        <td>

                                            <code>

                                                <%= order.razorpayOrderId %>

                                            </code>

                                        </td>

                                    </tr>

                                    <% } %>

                                    <% if(order.razorpayPaymentId){ %>

                                    <tr>

                                        <th>

                                            Payment ID

                                        </th>

                                        <td>

                                            <code>

                                                <%= order.razorpayPaymentId %>

                                            </code>

                                        </td>

                                    </tr>

                                    <% } %>

                                    <% if(order.receipt){ %>

                                    <tr>

                                        <th>

                                            Receipt

                                        </th>

                                        <td>

                                            <%= order.receipt %>

                                        </td>

                                    </tr>

                                    <% } %>

                                    <% if(order.paidAt){ %>

                                    <tr>

                                        <th>

                                            Paid At

                                        </th>

                                        <td>

                                            <%= new Date(order.paidAt).toLocaleString("en-IN") %>

                                        </td>

                                    </tr>

                                    <% } %>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Shiprocket & Tracking -->

                <div class="row mt-4">
                                      <!-- Shiprocket -->

                    <div class="col-lg-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body p-4">

                                <div class="d-flex justify-content-between align-items-center mb-4">

                                    <h5 class="fw-bold mb-0">

                                        Shiprocket Details

                                    </h5>

                                    <% if(order.shiprocket?.trackingUrl){ %>

                                        <a
                                            href="<%= order.shiprocket.trackingUrl %>"
                                            target="_blank"
                                            class="btn btn-outline-primary btn-sm"
                                        >

                                            <i class="bi bi-box-arrow-up-right me-2"></i>

                                            Track

                                        </a>

                                    <% } %>

                                </div>

                                <table class="table table-borderless">

                                    <tr>

                                        <th width="160">

                                            Courier

                                        </th>

                                        <td>

                                            <%= order.shiprocket?.courierName || "-" %>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            Shipment ID

                                        </th>

                                        <td>

                                            <%= order.shiprocket?.shipmentId || "-" %>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            AWB

                                        </th>

                                        <td>

                                            <code>

                                                <%= order.shiprocket?.awbCode || "-" %>

                                            </code>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            Current Status

                                        </th>

                                        <td>

                                            <span class="badge bg-primary">

                                                <%= order.shiprocket?.currentStatus || "Not Available" %>

                                            </span>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            Last Synced

                                        </th>

                                        <td>

                                            <% if(order.shiprocket?.lastSyncedAt){ %>

                                                <%= new Date(order.shiprocket.lastSyncedAt).toLocaleString("en-IN") %>

                                            <% } else { %>

                                                -

                                            <% } %>

                                        </td>

                                    </tr>

                                </table>

                            </div>

                        </div>

                    </div>

                    <!-- Timeline -->

                    <div class="col-lg-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body p-4">

                                <h5 class="fw-bold mb-4">

                                    Tracking Timeline

                                </h5>

                                <% if(order.tracking && order.tracking.length){ %>

                                    <div class="timeline">

                                        <% order.tracking.forEach(track=>{ %>

                                            <div class="d-flex mb-4">

                                                <div class="me-3">

                                                    <div
                                                        class="bg-success rounded-circle"
                                                        style="width:14px;height:14px;margin-top:6px;"
                                                    ></div>

                                                </div>

                                                <div>

                                                    <h6 class="mb-1">

                                                        <%= track.status %>

                                                    </h6>

                                                    <small class="text-muted d-block">

                                                        <%= track.location || "" %>

                                                    </small>

                                                    <small class="text-muted">

                                                        <%= track.message || "" %>

                                                    </small>

                                                    <div class="small text-secondary mt-1">

                                                        <%= new Date(track.date).toLocaleString("en-IN") %>

                                                    </div>

                                                </div>

                                            </div>

                                        <% }) %>

                                    </div>

                                <% } else { %>

                                    <div class="text-center text-muted py-5">

                                        <i class="bi bi-truck fs-1"></i>

                                        <p class="mt-3">

                                            No tracking history available.

                                        </p>

                                    </div>

                                <% } %>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Admin Actions -->

                <div class="card border-0 shadow-sm rounded-4 mt-4">

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-4">

                            Update Order Status

                        </h5>

                        <form
                            action="/admin/orders/<%= order._id %>/status?_method=PUT"
                            method="POST"
                        >

                            <div class="row g-3 align-items-end">

                                <div class="col-md-6">

                                    <label class="form-label">

                                        Order Status

                                    </label>

                                    <select
                                        name="orderStatus"
                                        class="form-select"
                                    >

                                        <option value="PLACED" <%= order.orderStatus==="PLACED"?"selected":"" %>>

                                            Placed

                                        </option>

                                        <option value="CONFIRMED" <%= order.orderStatus==="CONFIRMED"?"selected":"" %>>

                                            Confirmed

                                        </option>

                                        <option value="PACKED" <%= order.orderStatus==="PACKED"?"selected":"" %>>

                                            Packed

                                        </option>

                                        <option value="SHIPPED" <%= order.orderStatus==="SHIPPED"?"selected":"" %>>

                                            Shipped

                                        </option>

                                        <option value="OUT_FOR_DELIVERY" <%= order.orderStatus==="OUT_FOR_DELIVERY"?"selected":"" %>>

                                            Out For Delivery

                                        </option>

                                        <option value="DELIVERED" <%= order.orderStatus==="DELIVERED"?"selected":"" %>>

                                            Delivered

                                        </option>

                                        <option value="CANCELLED" <%= order.orderStatus==="CANCELLED"?"selected":"" %>>

                                            Cancelled

                                        </option>

                                        <option value="RETURNED" <%= order.orderStatus==="RETURNED"?"selected":"" %>>

                                            Returned

                                        </option>

                                    </select>

                                </div>

                                <div class="col-md-6">

                                    <button
                                        type="submit"
                                        class="btn btn-primary"
                                    >

                                        <i class="bi bi-check-circle me-2"></i>

                                        Update Status

                                    </button>

                                </div>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </section>

        <%- include("../../partials/footer") %>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>