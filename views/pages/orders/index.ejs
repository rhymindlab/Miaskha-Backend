<!DOCTYPE html>
<html lang="en">

<%- include("../../partials/head") %>

<body>

<div class="admin-wrapper">

    <!-- Sidebar -->

    <%- include("../../partials/sidebar") %>

    <!-- Main -->

    <main class="admin-main">

        <!-- Header -->

        <%- include("../../partials/header") %>

        <!-- Content -->

        <section class="admin-content">

            <div class="container-fluid">

                <!-- Page Header -->

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>

                        <h2 class="fw-bold mb-1">

                            Orders

                        </h2>

                        <p class="text-muted mb-0">

                            Manage customer orders, payments and deliveries.

                        </p>

                    </div>

                </div>

                <!-- Statistics -->

                <div class="row g-4 mb-4">

                    <!-- Total Orders -->

                    <div class="col-xl-3 col-md-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <small class="text-muted">

                                            Total Orders

                                        </small>

                                        <h2 class="fw-bold mt-2 mb-0">

                                            <%= orders.length %>

                                        </h2>

                                    </div>

                                    <div
                                        class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center"
                                        style="width:65px;height:65px;"
                                    >

                                        <i class="bi bi-bag-check fs-2 text-primary"></i>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Revenue -->

                    <div class="col-xl-3 col-md-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <small class="text-muted">

                                            Revenue

                                        </small>

                                        <h2 class="fw-bold mt-2 mb-0">

                                            ₹<%= orders.reduce((sum,order)=>sum+(order.amount||0),0).toLocaleString("en-IN") %>

                                        </h2>

                                    </div>

                                    <div
                                        class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center"
                                        style="width:65px;height:65px;"
                                    >

                                        <i class="bi bi-currency-rupee fs-2 text-success"></i>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Pending -->

                    <div class="col-xl-3 col-md-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <small class="text-muted">

                                            Pending

                                        </small>

                                        <h2 class="fw-bold mt-2 mb-0">

                                            <%= orders.filter(order=>order.orderStatus==="PENDING").length %>

                                        </h2>

                                    </div>

                                    <div
                                        class="rounded-circle bg-warning bg-opacity-10 d-flex align-items-center justify-content-center"
                                        style="width:65px;height:65px;"
                                    >

                                        <i class="bi bi-clock-history fs-2 text-warning"></i>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Delivered -->

                    <div class="col-xl-3 col-md-6">

                        <div class="card border-0 shadow-sm rounded-4 h-100">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <small class="text-muted">

                                            Delivered

                                        </small>

                                        <h2 class="fw-bold mt-2 mb-0">

                                            <%= orders.filter(order=>order.orderStatus==="DELIVERED").length %>

                                        </h2>

                                    </div>

                                    <div
                                        class="rounded-circle bg-info bg-opacity-10 d-flex align-items-center justify-content-center"
                                        style="width:65px;height:65px;"
                                    >

                                        <i class="bi bi-truck fs-2 text-info"></i>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
                                <!-- Orders Table -->

                <div class="card border-0 shadow-sm rounded-4">

                    <!-- Header -->

                    <div class="card-header bg-white border-0 p-4">

                        <div class="row g-3 align-items-center">

                            <!-- Search -->

                            <div class="col-lg-4">

                                <div class="position-relative">

                                    <i
                                        class="bi bi-search position-absolute"
                                        style="left:15px;top:50%;transform:translateY(-50%);"
                                    ></i>

                                    <input
                                        type="text"
                                        id="orderSearch"
                                        class="form-control ps-5"
                                        placeholder="Search Order, Customer..."
                                    >

                                </div>

                            </div>

                            <!-- Payment Filter -->

                            <div class="col-lg-2">

                                <select
                                    class="form-select"
                                    id="paymentFilter"
                                >

                                    <option value="">

                                        All Payments

                                    </option>

                                    <option value="SUCCESS">

                                        Paid

                                    </option>

                                    <option value="PENDING">

                                        Pending

                                    </option>

                                    <option value="FAILED">

                                        Failed

                                    </option>

                                    <option value="REFUNDED">

                                        Refunded

                                    </option>

                                </select>

                            </div>

                            <!-- Status Filter -->

                            <div class="col-lg-2">

                                <select
                                    class="form-select"
                                    id="statusFilter"
                                >

                                    <option value="">

                                        All Status

                                    </option>

                                    <option value="PENDING">

                                        Pending

                                    </option>

                                    <option value="PACKED">

                                        Packed

                                    </option>

                                    <option value="SHIPPED">

                                        Shipped

                                    </option>

                                    <option value="OUT_FOR_DELIVERY">

                                        Out For Delivery

                                    </option>

                                    <option value="DELIVERED">

                                        Delivered

                                    </option>

                                    <option value="CANCELLED">

                                        Cancelled

                                    </option>

                                </select>

                            </div>

                            <!-- Sort -->

                            <div class="col-lg-2">

                                <select
                                    class="form-select"
                                >

                                    <option>

                                        Latest First

                                    </option>

                                    <option>

                                        Oldest First

                                    </option>

                                </select>

                            </div>

                            <!-- Export -->

                            <div class="col-lg-2 text-lg-end">

                                <button
                                    class="btn btn-outline-dark w-100"
                                >

                                    <i class="bi bi-download me-2"></i>

                                    Export

                                </button>

                            </div>

                        </div>

                    </div>

                    <!-- Table -->

                    <div class="table-responsive">

                        <table
                            class="table table-hover align-middle mb-0"
                        >

                            <thead class="table-light">

                                <tr>

                                    <th>#</th>

                                    <th>Customer</th>

                                    <th>Items</th>

                                    <th>Amount</th>

                                    <th>Payment</th>

                                    <th>Status</th>

                                    <th>Date</th>

                                    <th class="text-center">

                                        Actions

                                    </th>

                                </tr>

                            </thead>

                            <tbody id="ordersTable">

                                <% if(orders.length === 0){ %>

                                <tr>

                                    <td
                                        colspan="8"
                                        class="text-center py-5"
                                    >

                                        <i
                                            class="bi bi-bag-x display-3 text-secondary"
                                        ></i>

                                        <h5 class="mt-3">

                                            No Orders Found

                                        </h5>

                                        <p class="text-muted">

                                            Orders will appear here after customers place them.

                                        </p>

                                    </td>

                                </tr>

                                <% } %>

                                <% orders.forEach((order,index)=>{ %>

                                <tr>

                                    <td>

                                        <strong>

                                            #<%= order.orderNumber %>

                                        </strong>

                                    </td>

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div
                                                class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center me-3"
                                                style="width:42px;height:42px;"
                                            >

                                                <%= (order.user?.firstName || "C").charAt(0).toUpperCase() %>

                                            </div>

                                            <div>

                                                <div class="fw-semibold">

                                                    <%= order.user?.firstName || order.user?.userName || "Customer" %>

                                                    <%= order.user?.lastName || "" %>

                                                </div>

                                                <small class="text-muted">

                                                    <%= order.user?.email || "" %>

                                                </small>

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        <span
                                            class="badge bg-secondary"
                                        >

                                            <%= order.items?.length || 0 %>

                                            Item<%= (order.items?.length || 0) > 1 ? "s" : "" %>

                                        </span>

                                    </td>
                                                                        <!-- Amount -->

                                    <td>

                                        <strong>

                                            ₹<%= Number(order.amount || order.totalAmount || 0).toLocaleString("en-IN") %>

                                        </strong>

                                    </td>

                                    <!-- Payment Status -->

                                    <td>

                                        <% if(order.paymentStatus === "SUCCESS"){ %>

                                            <span class="badge bg-success">

                                                Paid

                                            </span>

                                        <% } else if(order.paymentStatus === "FAILED"){ %>

                                            <span class="badge bg-danger">

                                                Failed

                                            </span>

                                        <% } else if(order.paymentStatus === "REFUNDED"){ %>

                                            <span class="badge bg-info">

                                                Refunded

                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-warning text-dark">

                                                Pending

                                            </span>

                                        <% } %>

                                    </td>

                                    <!-- Order Status -->

                                    <td>

                                        <% if(order.orderStatus === "PENDING"){ %>

                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>

                                        <% } else if(order.orderStatus === "PACKED"){ %>

                                            <span class="badge bg-primary">
                                                Packed
                                            </span>

                                        <% } else if(order.orderStatus === "SHIPPED"){ %>

                                            <span class="badge bg-info">
                                                Shipped
                                            </span>

                                        <% } else if(order.orderStatus === "OUT_FOR_DELIVERY"){ %>

                                            <span class="badge bg-secondary">
                                                Out For Delivery
                                            </span>

                                        <% } else if(order.orderStatus === "DELIVERED"){ %>

                                            <span class="badge bg-success">
                                                Delivered
                                            </span>

                                        <% } else if(order.orderStatus === "CANCELLED"){ %>

                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-light text-dark">
                                                <%= order.orderStatus %>
                                            </span>

                                        <% } %>

                                    </td>

                                    <!-- Date -->

                                    <td>

                                        <%= new Date(order.createdAt).toLocaleDateString("en-IN") %>

                                    </td>

                                    <!-- Actions -->

                                    <td>

                                        <div class="d-flex justify-content-center gap-2">

                                            <a
                                                href="/admin/orders/<%= order._id %>"
                                                class="btn btn-primary btn-sm"
                                                title="View Order"
                                            >

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <a
                                                href="/admin/orders/<%= order._id %>"
                                                class="btn btn-warning btn-sm text-white"
                                                title="Manage Order"
                                            >

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </section>

        <!-- Footer -->

        <%- include("../../partials/footer") %>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<script>

const search = document.getElementById("orderSearch");
const payment = document.getElementById("paymentFilter");
const status = document.getElementById("statusFilter");

function filterOrders(){

    const keyword = search.value.toLowerCase();

    document.querySelectorAll("#ordersTable tr").forEach(row=>{

        const text = row.innerText.toLowerCase();

        const paymentText = row.children[4]?.innerText.trim().toUpperCase() || "";

        const statusText = row.children[5]?.innerText.trim().toUpperCase() || "";

        const searchMatch = text.includes(keyword);

        const paymentMatch = payment.value === "" || paymentText.includes(payment.value);

        const statusMatch = status.value === "" || statusText.includes(status.value.replaceAll("_"," "));

        row.style.display = (searchMatch && paymentMatch && statusMatch)
            ? ""
            : "none";

    });

}

search.addEventListener("keyup", filterOrders);

payment.addEventListener("change", filterOrders);

status.addEventListener("change", filterOrders);

</script>

</body>

</html>