<!DOCTYPE html>
<html lang="en">

<%- include("../../partials/head",{ title:"Products" }) %>

<body>

<div class="admin-wrapper">

    <%- include("../../partials/sidebar") %>

    <main class="admin-main">

        <%- include("../../partials/header",{
            pageTitle:"Products"
        }) %>

        <section class="admin-content">

            <!-- =======================================
                PAGE HEADER
            ======================================== -->

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h2 class="fw-bold mb-1">

                        Product Management

                    </h2>

                    <p class="text-muted mb-0">

                        Manage all jewellery products.

                    </p>

                </div>

                <div class="d-flex gap-2">

                    <a
                        href="/admin/products/add"
                        class="btn btn-success">

                        <i class="bi bi-plus-circle me-2"></i>

                        Add Product

                    </a>

                    <button
                        class="btn btn-outline-secondary">

                        <i class="bi bi-download me-2"></i>

                        Export

                    </button>

                </div>

            </div>

            <!-- =======================================
                STATS
            ======================================== -->

            <div class="row g-4 mb-4">

                <div class="col-lg-3">

                    <div class="dashboard-card">

                        <div class="d-flex justify-content-between">

                            <div>

                                <small class="text-muted">

                                    Products

                                </small>

                                <h2>

                                    <%= products.length %>

                                </h2>

                            </div>

                            <i class="bi bi-box-seam fs-1 text-success"></i>

                        </div>

                    </div>

                </div>

                <div class="col-lg-3">

                    <div class="dashboard-card">

                        <div class="d-flex justify-content-between">

                            <div>

                                <small class="text-muted">

                                    Active

                                </small>

                                <h2>

                                    <%= products.filter(p=>p.isActive).length %>

                                </h2>

                            </div>

                            <i class="bi bi-check-circle fs-1 text-primary"></i>

                        </div>

                    </div>

                </div>

                <div class="col-lg-3">

                    <div class="dashboard-card">

                        <div class="d-flex justify-content-between">

                            <div>

                                <small class="text-muted">

                                    Low Stock

                                </small>

                                <h2>

                                    <%= products.filter(p=>p.stock<=5 && p.stock>0).length %>

                                </h2>

                            </div>

                            <i class="bi bi-exclamation-circle fs-1 text-warning"></i>

                        </div>

                    </div>

                </div>

                <div class="col-lg-3">

                    <div class="dashboard-card">

                        <div class="d-flex justify-content-between">

                            <div>

                                <small class="text-muted">

                                    Out of Stock

                                </small>

                                <h2>

                                    <%= products.filter(p=>p.stock===0).length %>

                                </h2>

                            </div>

                            <i class="bi bi-x-circle fs-1 text-danger"></i>

                        </div>

                    </div>

                </div>

            </div>

            <!-- =======================================
                PART 2 STARTS HERE
            ======================================= -->


            <!-- =======================================
    FILTER BAR
======================================= -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <div class="row g-3 align-items-end">

            <!-- Search -->

            <div class="col-xl-3 col-lg-6">

                <label class="form-label">

                    Search Product

                </label>

                <div class="input-group">

                    <span class="input-group-text">

                        <i class="bi bi-search"></i>

                    </span>

                    <input
                        type="text"
                        class="form-control"
                        placeholder="Name or SKU">

                </div>

            </div>

            <!-- Category -->

            <div class="col-xl-2 col-lg-6">

                <label class="form-label">

                    Category

                </label>

                <select class="form-select">

                    <option>

                        All Categories

                    </option>

                </select>

            </div>

            <!-- Collection -->

            <div class="col-xl-2 col-lg-6">

                <label class="form-label">

                    Collection

                </label>

                <select class="form-select">

                    <option>

                        All Collections

                    </option>

                </select>

            </div>

            <!-- Metal -->

            <div class="col-xl-2 col-lg-6">

                <label class="form-label">

                    Metal

                </label>

                <select class="form-select">

                    <option>

                        All Metals

                    </option>

                    <option>

                        Gold

                    </option>

                    <option>

                        Silver

                    </option>

                    <option>

                        Platinum

                    </option>

                </select>

            </div>

            <!-- Status -->

            <div class="col-xl-2 col-lg-6">

                <label class="form-label">

                    Status

                </label>

                <select class="form-select">

                    <option>

                        All

                    </option>

                    <option>

                        Active

                    </option>

                    <option>

                        Inactive

                    </option>

                </select>

            </div>

            <!-- Reset -->

            <div class="col-xl-1 col-lg-6">

                <button
                    class="btn btn-outline-secondary w-100">

                    <i class="bi bi-arrow-clockwise"></i>

                </button>

            </div>

        </div>

    </div>

</div>

<!-- =======================================
    BULK ACTION BAR
======================================= -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div class="d-flex gap-2">

                <button class="btn btn-outline-danger">

                    Delete Selected

                </button>

                <button class="btn btn-outline-success">

                    Export

                </button>

            </div>

            <small class="text-muted">

                Total Products :
                <strong>

                    <%= products.length %>

                </strong>

            </small>

        </div>

    </div>

</div>

<!-- =======================================
    PART 3 STARTS HERE
======================================= -->

<!-- =======================================
    PRODUCTS TABLE
======================================= -->

<div class="card shadow-sm border-0">

    <div class="card-header bg-white">

        <div class="d-flex justify-content-between align-items-center">

            <h5 class="mb-0">

                Product List

            </h5>

            <span class="badge bg-success">

                <%= products.length %> Products

            </span>

        </div>

    </div>

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">

                <tr>

                    <th width="40">

                        <input
                            class="form-check-input"
                            type="checkbox">

                    </th>

                    <th width="90">

                        Image

                    </th>

                    <th>

                        Product

                    </th>

                    <th>

                        SKU

                    </th>

                    <th>

                        Category

                    </th>

                    <th>

                        Price

                    </th>

                    <th>

                        Stock

                    </th>

                    <th>

                        Status

                    </th>

                    <th class="text-center">

                        Actions

                    </th>

                </tr>

            </thead>

            <tbody>

            <% if(products.length){ %>

                <% products.forEach(product=>{ %>

                <tr>

                    <td>

                        <input
                            class="form-check-input"
                            type="checkbox">

                    </td>

                    <!-- Product Image -->

                    <td>

                        <% if(product.images && product.images.length){ %>

                        <img
                            src="<%= product.images[0] %>"
                            class="rounded border"
                            style="
                                width:60px;
                                height:60px;
                                object-fit:cover;
                            ">

                        <% } else { %>

                        <div
                            class="bg-light border rounded d-flex align-items-center justify-content-center"
                            style="
                                width:60px;
                                height:60px;
                            ">

                            <i class="bi bi-image text-muted"></i>

                        </div>

                        <% } %>

                    </td>

                    <!-- Product -->

                    <td>

                        <strong>

                            <%= product.title %>

                        </strong>

                        <br>

                        <small class="text-muted">

                            <%= product.productType || "-" %>

                        </small>

                    </td>

                    <!-- SKU -->

                    <td>

                        <span class="badge bg-secondary">

                            <%= product.sku %>

                        </span>

                    </td>

                    <!-- Category -->

                    <td>

                        <%= product.category?.name || "-" %>

                    </td>

                    <!-- Price -->

                    <td>

                        <strong>

                            ₹ <%= Number(product.salePrice).toLocaleString("en-IN") %>

                        </strong>

                    </td>

                    <!-- Stock -->

                    <td>

                        <% if(product.stock===0){ %>

                        <span class="badge bg-danger">

                            Out

                        </span>

                        <% } else if(product.stock<=5){ %>

                        <span class="badge bg-warning text-dark">

                            <%= product.stock %>

                        </span>

                        <% } else { %>

                        <span class="badge bg-success">

                            <%= product.stock %>

                        </span>

                        <% } %>

                    </td>

                    <!-- Status -->

                    <td>

                        <% if(product.isActive){ %>

                        <span class="badge bg-success">

                            Active

                        </span>

                        <% } else { %>

                        <span class="badge bg-secondary">

                            Inactive

                        </span>

                        <% } %>

                    </td>

                    <!-- Actions -->

                    <td>

                        <div class="d-flex justify-content-center gap-2">

                            <a
                                href="/admin/products/<%= product._id %>"
                                class="btn btn-sm btn-outline-primary"
                                title="View">

                                <i class="bi bi-eye"></i>

                            </a>

                            <a
                                href="/admin/products/<%= product._id %>/edit"
                                class="btn btn-sm btn-outline-warning"
                                title="Edit">

                                <i class="bi bi-pencil"></i>

                            </a>

                            <button
                                class="btn btn-sm btn-outline-danger"
                                onclick="deleteProduct('<%= product._id %>')"
                                title="Delete">

                                <i class="bi bi-trash"></i>

                            </button>

                        </div>

                    </td>

                </tr>

                <% }) %>

            <% } else { %>

                <tr>

                    <td
                        colspan="9"
                        class="text-center py-5">

                        <i class="bi bi-box display-5 text-muted"></i>

                        <h5 class="mt-3">

                            No Products Found

                        </h5>

                        <a
                            href="/admin/products/add"
                            class="btn btn-success mt-2">

                            Add First Product

                        </a>

                    </td>

                </tr>

            <% } %>

            </tbody>

        </table>

    </div>

</div>

<!-- =======================================
    PART 4 STARTS HERE
======================================= -->

<!-- =======================================
    TABLE FOOTER
======================================= -->

<div class="card border-0 shadow-sm mt-4">

    <div class="card-body">

        <div class="row align-items-center">

            <!-- Showing Results -->

            <div class="col-md-4">

                <small class="text-muted">

                    Showing

                    <strong>

                        <%= products.length ? 1 : 0 %>

                    </strong>

                    -

                    <strong>

                        <%= products.length %>

                    </strong>

                    of

                    <strong>

                        <%= products.length %>

                    </strong>

                    Products

                </small>

            </div>

            <!-- Bulk Actions -->

            <div class="col-md-4 text-center">

                <div class="btn-group">

                    <button
                        class="btn btn-outline-success btn-sm">

                        Activate

                    </button>

                    <button
                        class="btn btn-outline-secondary btn-sm">

                        Deactivate

                    </button>

                    <button
                        class="btn btn-outline-danger btn-sm">

                        Delete Selected

                    </button>

                </div>

            </div>

            <!-- Pagination -->

            <div class="col-md-4">

                <nav class="float-md-end mt-3 mt-md-0">

                    <ul class="pagination pagination-sm mb-0">

                        <li class="page-item disabled">

                            <a
                                class="page-link"
                                href="#">

                                Previous

                            </a>

                        </li>

                        <li class="page-item active">

                            <a
                                class="page-link"
                                href="#">

                                1

                            </a>

                        </li>

                        <li class="page-item">

                            <a
                                class="page-link"
                                href="#">

                                Next

                            </a>

                        </li>

                    </ul>

                </nav>

            </div>

        </div>

    </div>

</div>

<!-- =======================================
    DELETE MODAL
======================================= -->

<div
    class="modal fade"
    id="deleteModal"
    tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    Delete Product

                </h5>

                <button
                    class="btn-close"
                    data-bs-dismiss="modal">

                </button>

            </div>

            <div class="modal-body">

                <div class="text-center">

                    <i
                        class="bi bi-trash-fill text-danger"
                        style="font-size:60px;">

                    </i>

                    <h4 class="mt-3">

                        Are you sure?

                    </h4>

                    <p class="text-muted">

                        This action cannot be undone.

                    </p>

                </div>

            </div>

            <div class="modal-footer">

                <button
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">

                    Cancel

                </button>

                <button
                    id="confirmDeleteBtn"
                    class="btn btn-danger">

                    Delete

                </button>

            </div>

        </div>

    </div>

</div>

        </section>

    </main>

</div>

<!-- =======================================
    PART 5 STARTS HERE
======================================= -->
<script src="/js/products.js"></script>

</body>

</html>